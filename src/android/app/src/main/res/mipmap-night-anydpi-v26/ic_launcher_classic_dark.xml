<?xml version="1.0" encoding="utf-8"?>
<adaptive-icon xmlns:android="http://schemas.android.com/apk/res/android">
    <background android:drawable="@color/ic_launcher_bg_force_dark" />
    <!-- Forced "Dark" variant (see the day variant). The -night copy pins
         the same DroidPilot plane foreground — the vector has no -night
         qualifier, so the pinned icon is identical in both system modes. -->
    <foreground>
        <inset
            android:drawable="@drawable/ic_launcher_foreground_droidpilot"
            android:inset="15%" />
    </foreground>
    <!-- T-android-themed-icons: monochrome layer (see day variant). -->
    <monochrome android:drawable="@drawable/ic_launcher_monochrome" />
</adaptive-icon>
