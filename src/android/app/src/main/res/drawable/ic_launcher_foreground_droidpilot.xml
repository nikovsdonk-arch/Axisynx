<?xml version="1.0" encoding="utf-8"?>
<!--
  DroidPilot brand foreground: a stylized paper-plane "pilot" glyph in
  solid white, drawn on the standard adaptive-icon 108dp x 108dp canvas.
  The adaptive-icon XMLs apply a 15% inset, which brings the glyph
  (spanning 18..90 here) down to ~50dp — inside the 66dp safe zone.
  Solid single-color path so it re-tints cleanly and reads at small sizes.
-->
<vector xmlns:android="http://schemas.android.com/apk/res/android"
    android:width="108dp"
    android:height="108dp"
    android:viewportWidth="108"
    android:viewportHeight="108">
    <path
        android:fillColor="#FFFFFFFF"
        android:pathData="M18,54 L90,18 L62,90 L50,62 Z" />
</vector>
