<?xml version="1.0" encoding="utf-8"?>
<!--
  T-android-themed-icons: monochrome counterpart to the DroidPilot
  paper-plane app icon (ic_launcher_foreground_droidpilot.xml). Required
  for Android 13+ Themed Icons (Settings → Wallpaper & style → Themed
  icons). The system tints this drawable with the active monochromatic
  palette at runtime; we just provide the silhouette in solid white.

  Canvas is the standard adaptive-icon 108dp x 108dp. The glyph is the
  same plane as the colored foreground, scaled down so every point sits
  inside the themed-icon circular clip (center (54,54), radius 33):
  farthest point (77,31) is at ~32.8 from center.
-->
<vector xmlns:android="http://schemas.android.com/apk/res/android"
    android:width="108dp"
    android:height="108dp"
    android:viewportWidth="108"
    android:viewportHeight="108">
    <path
        android:fillColor="#FFFFFFFF"
        android:pathData="M31,54 L77,31 L59,77 L51,59 Z" />
</vector>
