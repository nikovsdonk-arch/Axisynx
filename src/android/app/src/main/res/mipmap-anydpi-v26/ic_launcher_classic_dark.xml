<?xml version="1.0" encoding="utf-8"?>
<adaptive-icon xmlns:android="http://schemas.android.com/apk/res/android">
    <background android:drawable="@color/ic_launcher_bg_force_dark" />
    <!-- Forced "Dark" app-icon variant: deep-indigo background
         (@color/ic_launcher_bg_force_dark) with the same white DroidPilot
         plane foreground — the brand glyph is theme-independent, so all
         variants share @drawable/ic_launcher_foreground_droidpilot. -->
    <foreground>
        <inset
            android:drawable="@drawable/ic_launcher_foreground_droidpilot"
            android:inset="15%" />
    </foreground>
    <!-- T-android-themed-icons: monochrome layer (see ic_launcher.xml). -->
    <monochrome android:drawable="@drawable/ic_launcher_monochrome" />
</adaptive-icon>
