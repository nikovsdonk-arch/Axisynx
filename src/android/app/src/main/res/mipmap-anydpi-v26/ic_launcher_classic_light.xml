<?xml version="1.0" encoding="utf-8"?>
<adaptive-icon xmlns:android="http://schemas.android.com/apk/res/android">
    <background android:drawable="@color/ic_launcher_bg_force_light" />
    <!-- Forced "Light" app-icon variant: brand indigo background
         (@color/ic_launcher_bg_force_light) with the white DroidPilot
         plane foreground, shared by all icon variants. -->
    <foreground>
        <inset
            android:drawable="@drawable/ic_launcher_foreground_droidpilot"
            android:inset="15%" />
    </foreground>
    <!-- T-android-themed-icons: monochrome layer (see ic_launcher.xml). -->
    <monochrome android:drawable="@drawable/ic_launcher_monochrome" />
</adaptive-icon>
